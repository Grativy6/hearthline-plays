{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Grativy6/hearthline-plays/launch/schemas/v2/stage-result.schema.json",
  "title": "Hearthline ARC private-kernel stage result v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "candidate", "kernel_id", "kernel_run_id",
    "kernel_visibility", "internet_enabled", "output_reviewed", "submission",
    "recorded_by_human", "credential_material_recorded",
    "external_effect_performed_by_gate_tool", "gate_a", "runtime_inventory",
    "recorded_at", "claim_ceiling"
  ],
  "properties": {
    "schema": {"const": "hearthline.arc3.kaggle-stage-result.v3"},
    "status": {"enum": ["COMPLETE", "FAILED"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit", "tree", "account_slug", "kernel_id", "accelerator",
        "agent_sha256", "builder_sha256", "notebook_sha256",
        "kernel_metadata_sha256", "source_lock_sha256",
        "candidate_manifest_sha256", "verified_snapshot_sha256"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "account_slug": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,62}$"},
        "kernel_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,62}/hearthline-arc3-readiness$"},
        "accelerator": {"enum": ["cpu", "t4", "p100", "rtx6000"]},
        "agent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "builder_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "notebook_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kernel_metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "kernel_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,62}/hearthline-arc3-readiness$"},
    "kernel_run_id": {"type": "string", "minLength": 1},
    "kernel_visibility": {"const": "PRIVATE"},
    "internet_enabled": {"const": false},
    "output_reviewed": {"const": true},
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"const": "submission.parquet"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "recorded_by_human": {"const": true},
    "credential_material_recorded": {"const": false},
    "external_effect_performed_by_gate_tool": {"const": false},
    "gate_a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id", "nonce", "grant_sha256", "consumption_receipt_path",
        "consumption_receipt_sha256", "account_slug", "kernel_id"
      ],
      "properties": {
        "grant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "grant_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "consumption_receipt_path": {"type": "string", "pattern": "^\\.hearthline/receipts/gate-consumption/[0-9a-f]{64}\\.json$"},
        "consumption_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "account_slug": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,62}$"},
        "kernel_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,62}/hearthline-arc3-readiness$"}
      }
    },
    "runtime_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_from", "complete", "python_version", "distributions",
        "agents_repository", "agents_expected_commit", "agents_files",
        "agents_license_file", "reviewed_by_human"
      ],
      "properties": {
        "captured_from": {"const": "HEARTHLINE_STAGE_INVENTORY"},
        "complete": {"const": true},
        "python_version": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"},
        "distributions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": {"const": "arc-agi"},
                  "version": {"const": "0.9.9"}
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": {"const": "arcengine"},
                  "version": {"const": "0.9.3"}
                }
              }
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "agents_repository": {"const": "arcprize/ARC-AGI-3-Agents"},
        "agents_expected_commit": {"const": "4743e7d0aaae0ded0d98a89a7e282e63564cd58b"},
        "agents_files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agents/agent.py", "agents/recorder.py", "agents/swarm.py",
            "agents/tracing.py", "main.py"
          ],
          "properties": {
            "agents/agent.py": {"const": "49f1a349cd5e2123fceb266aec4a3a758d18ef5520e0212e808f695905d9e073"},
            "agents/recorder.py": {"const": "0a08d89f4067a760012767c05d4406bd2bf409f426e29a1193106abfcbb696c8"},
            "agents/swarm.py": {"const": "d9dc48f710f1b90a6552db0921293c7e89c8a925ed00a3faefa07ae19998ad39"},
            "agents/tracing.py": {"const": "951ca56508c524504e116303f7c64f4eb5cf723c72cab892d4d1a3292b1cc51f"},
            "main.py": {"const": "864254c750bbbd12a211f2d8aa1b1025d0609283f07dea4ede83722f2435301b"}
          }
        },
        "agents_license_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["LICENSE"],
          "properties": {
            "LICENSE": {"const": "75c4276c506fd93082b38ad39f67ee97aa859574401ef978e701710c7a40af04"}
          }
        },
        "reviewed_by_human": {"const": true}
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
