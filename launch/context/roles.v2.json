      "ablation": "Remove advisory account/witness checks while retaining the common two-gate hard shell."
    },
    {
      "role_id": "FBT_CONTINUATION_SPLIT",
      "default_enabled": false,
      "inputs": ["working state", "typed trace", "version and epoch"],
      "output": "continue/reopen proposal with divergence residual",
      "forbidden_outputs": ["authority renewal", "trace overwrite", "hidden cached state as evidence"],
      "ablation": "Reconstruct only from the typed trace; discard mutable continuation state."
    },
    {
      "role_id": "GOLD_1_PLUS_5_LENS",
      "default_enabled": false,
      "inputs": ["one common observation projection", "five declared comparison views"],
