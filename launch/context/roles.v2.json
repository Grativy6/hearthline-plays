      "forbidden_outputs": ["pooled confidence", "privileged geometry claim", "action authority"],
      "ablation": "Use the common projection and baseline geometry only."
    },
    {
      "role_id": "PAL_ROLE_LEDGER",
      "default_enabled": false,
      "inputs": ["role-typed events", "grant epoch", "residuals"],
      "output": "partitioned custody and reopening projection",
