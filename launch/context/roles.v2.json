      "default_enabled": false,
      "inputs": ["action-bit trace", "schedule cursor", "declared work projection"],
      "output": "exact checkpoint capsule and typed re-entry comparison",
      "forbidden_outputs": ["progress claim from heartbeat", "new budget", "unbounded correctness claim"],
      "ablation": "Restart from the ordinary immutable event prefix without a transport capsule."
    },
    {
      "role_id": "DISTINCTION_GROUPER",
      "default_enabled": false,
      "inputs": ["candidate statements and evidence handles"],
      "output": "groups: direct, derived, hypothesis, unresolved, plan-only",
