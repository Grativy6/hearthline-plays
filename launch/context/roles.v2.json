      "ablation": "Retain the fixed common-shell field types without higher-order grouping."
    },
    {
      "role_id": "ADVANCE_ATOMIC_PROMOTION",
      "default_enabled": false,
      "inputs": ["one named candidate field", "frozen promotion rule", "complete supporting evidence set"],
      "output": "either one complete successor field or no promotion plus residual",
      "forbidden_outputs": ["partial in-place mutation", "promotion from a plan", "retroactive source edit"],
      "ablation": "Disable promotion entirely; keep every candidate in hypotheses."
    },
    {
      "role_id": "GAME_EMBODIMENT_BOUNDARY",
      "default_enabled": false,
      "inputs": ["canonical FrameData heartbeat", "bounded intention", "available GameAction set"],
      "output": "one controller action proposal or stop",
      "forbidden_outputs": ["world-state overwrite", "new objective", "computer-wide control", "personhood claim"],
      "ablation": "Use the deterministic starter baseline under the same action/reset ceiling."
