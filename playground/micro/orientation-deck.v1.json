{
  "schema_version": "hearthline-public-micro.v1",
  "deck_id": "PUBLIC-ORIENTATION-001",
  "title": "Lantern rules: a tiny rule-acquisition practice deck",
  "origin": "ORIGINAL_HEARTHLINE_PRACTICE_MATERIAL",
