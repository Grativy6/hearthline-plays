{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthline-plays:schema:arc2:score-receipt:v1",
  "title": "Hearthline ARC-AGI-2 score receipt v1",
  "description": "A valid output-pair-weighted exact-match score. Public-evaluation receipts are aggregate-only; synthetic receipts may carry non-task diagnostic labels.",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "scorer_version",
    "scorer_sha256",
    "challenge_sha256",
    "solution_sha256",
    "submission_sha256",
    "numerator",
    "denominator",
    "score_numerator",
    "score_denominator",
    "score_decimal",
    "duplicate_attempt_count",
    "malformed_count",
    "aggregate_only",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "hearthline-plays.arc2-score-receipt.v1"
    },
    "mode": {
      "enum": [
        "SYNTHETIC",
        "PUBLIC_EVAL"
      ]
    },
    "authorization_grant_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scorer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scorer_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "challenge_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "solution_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "submission_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "numerator": {
      "type": "integer",
      "minimum": 0
    },
    "denominator": {
      "type": "integer",
      "minimum": 1
    },
    "score_numerator": {
      "type": "integer",
      "minimum": 0
    },
    "score_denominator": {
      "type": "integer",
      "minimum": 1
    },
    "score_decimal": {
      "type": "string",
      "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
    },
    "duplicate_attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "malformed_count": {
      "const": 0
    },
    "aggregate_only": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "VALID_AGGREGATE",
        "VALID_SYNTHETIC"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "message"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "PUBLIC_EVAL"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "authorization_grant_sha256",
          "run_manifest_sha256"
        ],
        "properties": {
          "aggregate_only": {
            "const": true
          },
          "status": {
            "const": "VALID_AGGREGATE"
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "authorization_grant_sha256"
              ]
            },
            {
              "required": [
                "run_manifest_sha256"
              ]
            }
          ]
        },
        "properties": {
          "aggregate_only": {
            "const": false
          },
          "status": {
            "const": "VALID_SYNTHETIC"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aggregate_only": {
            "const": true
          }
        },
        "required": [
          "aggregate_only"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "VALID_AGGREGATE"
          }
        },
        "not": {
          "required": [
            "diagnostics"
          ]
        }
      },
      "else": {
        "properties": {
          "status": {
            "const": "VALID_SYNTHETIC"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
