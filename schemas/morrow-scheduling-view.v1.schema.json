{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Grativy6/hearthline-plays/blob/arc-agi/titles/arc-agi-3-hearthline-launch-20260903/schemas/morrow-scheduling-view.v1.schema.json",
  "title": "Morrow frozen ready-only scheduling view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "invocation_cut_binding",
    "policy_ref",
    "maximum_overtakes",
    "ready_scheduling_view"
  ],
  "properties": {
    "schema": {"const": "hearthline-plays.morrow-scheduling-view.v1"},
    "status": {"const": "CONTROLLER_FROZEN_READY_ONLY_VIEW"},
    "invocation_cut_binding": {"$ref": "#/$defs/opaqueToken"},
    "policy_ref": {"const": "STABLE_EFFECTIVE_PRIORITY_THEN_APPROVED_COST_THEN_ARRIVAL_V2"},
    "maximum_overtakes": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "ready_scheduling_view": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "opaqueToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_queue_item_binding",
        "ready_arrival_rank",
        "effective_priority_rank",
        "controller_approved_processing_cost",
        "overtake_count"
      ],
      "properties": {
        "opaque_queue_item_binding": {"$ref": "#/$defs/opaqueToken"},
        "ready_arrival_rank": {"type": "integer", "minimum": 1, "maximum": 256},
        "effective_priority_rank": {"type": "integer", "minimum": 0, "maximum": 3},
        "controller_approved_processing_cost": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "overtake_count": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    }
  }
}
