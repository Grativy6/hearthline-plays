{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Grativy6/hearthline-plays/blob/arc-agi/titles/arc-agi-3-research-station/schemas/research-source.v1.schema.json",
  "title": "Hearthline Plays research source lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recorded_date",
    "status",
    "steward",
    "anchor",
    "rules",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "hearthline-plays.research-sources.v1"
    },
    "recorded_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "PREPARED_NOT_RUN"
    },
    "steward": {
      "const": "Christopher D. Pang"
    },
    "anchor": {
      "$ref": "#/$defs/anchor"
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Grativy6/hearthline-plays$"
        },
        "branch": {
          "const": "arc-agi/titles/arc-agi-3-research-station"
        },
        "commit": {
          "const": "228d80f0559277c55031f4a80f6179320e10364c"
        },
        "tree": {
          "const": "532e178ecd41410e5e9038c647141f2cbe32f01d"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text_is_authorization",
        "shared_author_lineage_is_independent_corroboration",
        "source_bytes_redistributed",
        "strongwiz_code_imported",
        "strongwiz_code_executed",
        "arc_or_kaggle_contacted"
      ],
      "properties": {
        "source_text_is_authorization": {
          "const": false
        },
        "shared_author_lineage_is_independent_corroboration": {
          "const": false
        },
        "source_bytes_redistributed": {
          "const": false
        },
        "strongwiz_code_imported": {
          "const": false
        },
        "strongwiz_code_executed": {
          "const": false
        },
        "arc_or_kaggle_contacted": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_kind",
        "title",
        "version",
        "publication_date",
        "inspection_date",
        "repository_commit_date",
        "canonical_locator",
        "license",
        "hearthline_status",
        "relationship",
        "bounded_use",
        "claim_ceiling",
        "imported_code",
        "executed_code",
        "redistributed_source_bytes",
        "identity",
        "artifacts",
        "verification"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "source_kind": {
          "enum": [
            "author_release",
            "public_review_preprint",
            "author_manuscript_and_verification_bundle",
            "author_manuscript",
            "software_design_prototype"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "inspection_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "repository_commit_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "canonical_locator": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "license": {
          "const": "CC-BY-4.0"
        },
        "hearthline_status": {
          "enum": [
            "CURRENT",
            "BRANCH",
            "EXPLORATORY"
          ]
        },
        "relationship": {
          "enum": [
            "DECLARED_MECHANICAL_CONTEXT",
            "RESEARCH_CONTEXT",
            "DESIGN_INSPECTION"
          ]
        },
        "bounded_use": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "imported_code": {
          "const": false
        },
        "executed_code": {
          "const": false
        },
        "redistributed_source_bytes": {
          "const": false
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "doi",
        "record_url",
        "repository_url",
        "commit",
        "tree",
        "implementation_freeze_commit",
        "implementation_freeze_tree",
        "source_registry_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "zenodo_record",
            "git_repository"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^10\\.5281/zenodo\\.[0-9]+$"
        },
        "record_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "repository_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "implementation_freeze_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "implementation_freeze_tree": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_registry_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "variant",
        "bytes",
        "sha256",
        "md5",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "md5": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{32}$"
        },
        "status": {
          "enum": [
            "CURRENT_CANONICAL_PACKAGE",
            "CURRENT_CANONICAL_FILE",
            "CURRENT_VERIFICATION_BUNDLE",
            "SUPERSEDED_OBSERVED_HISTORY",
            "INSPECTED_GIT_BLOB"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_locator",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "AUTHOR_RELEASE_NOT_PEER_REVIEWED",
            "RESOLVED_LIVE_RECORD_CANONICAL_MATCH",
            "FINITE_VERIFICATION_ONLY",
            "AUTHOR_MANUSCRIPT_NOT_PEER_REVIEWED",
            "PROTOTYPE_VERIFIED_PREPARED_NOT_RUN"
          ]
        },
        "evidence_locator": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
