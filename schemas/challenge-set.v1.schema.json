{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthline-plays:schema:arc2:challenge-set:v1",
  "title": "Hearthline ARC-AGI-2 solver-facing challenge set v1",
  "description": "A label-free ARC challenge map. Rectangularity and rejection of language-specific boolean values are enforced again by the runtime semantic validator.",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^[0-9a-f]{8}$": {
      "$ref": "#/$defs/task"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "grid": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "demonstration": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/grid"
        },
        "output": {
          "$ref": "#/$defs/grid"
        }
      },
      "additionalProperties": false
    },
    "test_input": {
      "type": "object",
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/grid"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "train",
        "test"
      ],
      "properties": {
        "train": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/demonstration"
          }
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test_input"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
