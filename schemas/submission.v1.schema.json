{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthline-plays:schema:arc2:submission:v1",
  "title": "Hearthline ARC-AGI-2 submission v1",
  "description": "Exactly two ordered output attempts for every test input. Task and test-input parity with the challenge set is enforced by the runtime semantic validator.",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^[0-9a-f]{8}$": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attempt_pair"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "grid": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "attempt_pair": {
      "type": "object",
      "required": [
        "attempt_1",
        "attempt_2"
      ],
      "properties": {
        "attempt_1": {
          "$ref": "#/$defs/grid"
        },
        "attempt_2": {
          "$ref": "#/$defs/grid"
        }
      },
      "additionalProperties": false
    }
  }
}
