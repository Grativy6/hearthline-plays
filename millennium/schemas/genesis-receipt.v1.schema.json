{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthline.example/schemas/millennium-genesis-receipt.v1.schema.json",
  "title": "Hearthline Millennium Playground genesis receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "event_id_scheme",
    "event_origin",
    "receipt_id",
    "status",
    "claimed_created_at_utc",
    "steward",
    "lineage",
    "credit",
    "scope",
    "claim_boundary",
    "official_sources",
    "private_checkpoint_commitment",
    "assistance_provenance",
    "attestation_status_at_creation",
    "verifier_notice"
  ],
  "properties": {
    "schema": {"const": "hearthline-plays.millennium-genesis.v1"},
    "event_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_id_scheme": {"type": "string", "minLength": 1},
    "event_origin": {"const": "model_drafted_pending_steward_review"},
    "receipt_id": {"type": "string", "minLength": 1},
    "status": {"const": "GENESIS_SEALED_PLAY_NOT_PROOF"},
    "claimed_created_at_utc": {"type": "string", "format": "date-time"},
    "steward": {"const": "Christopher D. Pang"},
    "lineage": {"type": "object"},
    "credit": {"type": "object"},
    "scope": {"type": "object"},
    "claim_boundary": {"type": "object"},
    "official_sources": {"type": "object"},
    "private_checkpoint_commitment": {"type": "object"},
    "assistance_provenance": {"type": "object"},
    "attestation_status_at_creation": {"type": "object"},
    "verifier_notice": {"type": "string", "minLength": 1}
  }
}
